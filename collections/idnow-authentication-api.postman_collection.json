      "item": [
        {
          "id": "ba908766-f969-4d12-9d65-ebe0c9edc4ef",
          "name": "Authenticate a company and obtain a login token.",
          "request": {
            "name": "Authenticate a company and obtain a login token.",
            "description": {
              "content": "Authenticates a company using its API key and returns a JSON Web Token (authToken) that must be sent as the X-API-LOGIN-TOKEN header on subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":company",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "company",
                  "description": "(Required) The company identifier issued by IDnow."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "55b02ec2-0ddf-4f21-8999-18801d4e3849",
              "name": "Authentication succeeded; returns the login token.",
              "originalRequest": {
                "url": {
                  "path": [
                    ":company",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "company",
                      "description": "(Required) The company identifier issued by IDnow."
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-API-LOGIN-TOKEN",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"apiKey\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"authToken\": \"string\"\n}",
              "cookie": [],
